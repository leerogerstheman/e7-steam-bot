# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 运行产物
logs/
*.log
.pytest_cache/

# 模板：只忽略你自己采的图，保留目录结构与说明
# （如果你想把模板一起提交，把这行注释掉即可）
templates/**/*.png
templates/**/*.json
!templates/**/README.md
!templates/**/.gitkeep

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# 本地覆盖配置（放你自己的关卡导航序列，不想提交就用它）
config/local.toml

# 录制工具生成的进本序列（每人关卡不同，不该进仓库）
config/recorded_sequence.toml

# 打包产物
build/
dist/
*.spec.bak

# 临时文件（调试用，别提交）
_tmp_*
~$*
